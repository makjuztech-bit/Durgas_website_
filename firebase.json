{
  "hosting": {
    "public": "frontend",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "/product/**",
        "destination": "/product-details.html"
      },
      {
        "source": "/product",
        "destination": "/product-details.html"
      },
      {
        "source": "/checkout",
        "destination": "/cart.html"
      },
      {
        "source": "/order",
        "destination": "/cart.html"
      }
    ]
  }
}
