{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "services": {
    "backend": {
      "root": "backend",
      "framework": "express"
    },
    "frontend": {
      "root": "frontend"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://durgas-backend.onrender.com/api/$1"
    },
    {
      "source": "/administrator(.*)",
      "destination": {
        "service": "frontend",
        "path": "/administrator/index.html"
      }
    },
    {
      "source": "/admin(.*)",
      "destination": {
        "service": "frontend",
        "path": "/administrator/index.html"
      }
    },
    {
      "source": "/product/(.*)",
      "destination": {
        "service": "frontend",
        "path": "/product-details.html"
      }
    },
    {
      "source": "/product-details",
      "destination": {
        "service": "frontend",
        "path": "/product-details.html"
      }
    },
    {
      "source": "/products",
      "destination": {
        "service": "frontend",
        "path": "/products.html"
      }
    },
    {
      "source": "/cart",
      "destination": {
        "service": "frontend",
        "path": "/cart.html"
      }
    },
    {
      "source": "/checkout",
      "destination": {
        "service": "frontend",
        "path": "/cart.html"
      }
    },
    {
      "source": "/order",
      "destination": {
        "service": "frontend",
        "path": "/cart.html"
      }
    },
    {
      "source": "/login",
      "destination": {
        "service": "frontend",
        "path": "/login.html"
      }
    },
    {
      "source": "/register",
      "destination": {
        "service": "frontend",
        "path": "/register.html"
      }
    },
    {
      "source": "/profile",
      "destination": {
        "service": "frontend",
        "path": "/profile.html"
      }
    },
    {
      "source": "/about",
      "destination": {
        "service": "frontend",
        "path": "/about.html"
      }
    },
    {
      "source": "/contact",
      "destination": {
        "service": "frontend",
        "path": "/contact.html"
      }
    },
    {
      "source": "/privacy-policy",
      "destination": {
        "service": "frontend",
        "path": "/privacy-policy.html"
      }
    },
    {
      "source": "/terms-and-conditions",
      "destination": {
        "service": "frontend",
        "path": "/terms-and-conditions.html"
      }
    },
    {
      "source": "/shipping-policy",
      "destination": {
        "service": "frontend",
        "path": "/shipping-policy.html"
      }
    },
    {
      "source": "/refund-policy",
      "destination": {
        "service": "frontend",
        "path": "/refund-policy.html"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
