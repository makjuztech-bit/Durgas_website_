{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "outputDirectory": "frontend",
  "redirects": [
    {
      "source": "/admin(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/administrator(.*)",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://durgas-backend.onrender.com/api/$1"
    },
    {
      "source": "/staff-portal(.*)",
      "destination": "/administrator/index.html"
    },
    {
      "source": "/product/(.*)",
      "destination": "/product-details.html"
    },
    {
      "source": "/product-details",
      "destination": "/product-details.html"
    },
    {
      "source": "/products",
      "destination": "/products.html"
    },
    {
      "source": "/cart",
      "destination": "/cart.html"
    },
    {
      "source": "/checkout",
      "destination": "/cart.html"
    },
    {
      "source": "/order",
      "destination": "/cart.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/register",
      "destination": "/register.html"
    },
    {
      "source": "/profile",
      "destination": "/profile.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/terms-and-conditions",
      "destination": "/terms-and-conditions.html"
    },
    {
      "source": "/shipping-policy",
      "destination": "/shipping-policy.html"
    },
    {
      "source": "/refund-policy",
      "destination": "/refund-policy.html"
    }
  ]
}
